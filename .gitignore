profile_default/
ipython_config.py

# pyenv
#   For a library or app, you might want to share your .python-version if the python version is fixed
#   For an engine/framework, to prevent conflicts, this file should be ignored.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if used with a binary dependency, may cause issues.
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, it is generally recommended to include poetry.lock in version control.
# poetry.lock

# pdm
#   Similar to Pipfile.lock, it is generally recommended to include pdm.lock in version control.
# pdm.lock

# virtualenv
#   Usually, environment folders are excluded to avoid committing huge amounts of third-party libraries.
.venv/
venv/
ENV/
env/
active_env/

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
